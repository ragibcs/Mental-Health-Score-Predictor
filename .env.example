[TEMPLATE]

# ===========================================================================
# Frontend (Vite)
# ===========================================================================
# Vite inlines VITE_* values at BUILD time, not runtime — set this before
# building, and redeploy after changing it. On Vercel this goes in
# Project Settings → Environment Variables.
VITE_API_BASE_URL=http://127.0.0.1:2200

# ===========================================================================
# Backend (FastAPI)
# ===========================================================================
# Comma-separated list of origins allowed to call the API. Set this to your
# deployed frontend URL in production, e.g. https://mindpulse.vercel.app
# A wildcard is deliberately not supported here — see the CORS block in main.py.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Secret used to sign JWT access tokens. Replace with a long random value.
JWT_SECRET=change-me-in-production

# SQLite database file. Note: Render's free tier has an ephemeral filesystem,
# so this file is wiped on every redeploy — use managed Postgres for real data.
SQLITE_DB=mental_health.db
